# ============================================================
# Grok 独立注册机 配置模板
# 复制本文件为 .env 后填写（或在 WebUI「配置」页填写并保存，效果相同）
# ============================================================

# ---- 临时邮箱（Grok 收验证码，至少配一个 provider）----
# provider: remail | yyds | gptmail | moemail | cfmail | custom
TEMP_EMAIL_PROVIDER=remail

# ReMail（主推，付费）：https://remail.aishop6.com 后台获取 rk- 开头 key
REMAIL_API_KEY=
REMAIL_PROJECT_ID=3
REMAIL_PRODUCT_ID=8

# YYDS Mail（备选）：AC- 开头 key，profile 页获取
YYDS_API_KEY=
YYDS_BASE_URL=https://maliapi.215.im

# GPTMail（备选）：公共测试 key=gpt-test
GPTMAIL_API_KEY=gpt-test

# ---- 打码平台（解 Cloudflare Turnstile，至少配一个）----
# CapSolver（主推）：https://dashboard.capsolver.com 注册充值，CAP- 开头
CAPSOLVER_API_KEY=
# EZ-Captcha（备选）：https://www.ez-captcha.com
EZCAPTCHA_API_KEY=
# YesCaptcha（备选）：https://yescaptcha.com
YESCAPTCHA_API_KEY=

# ---- 代理出口（必须可用）----
# 三种用法：
#   1) 内置代理池（默认）：本目录 miyaip_pool.txt 或 WebUI 粘贴的 proxies.txt，
#      relay 自动监听下方端口，每号分配独立 IP。
#   2) 单出口：CLASH_PROXY 填 Clash 混合端口如 http://127.0.0.1:7897，PROXY_CTRL 留空。
#   3) 已有代理池：CLASH_PROXY / PROXY_CTRL 都填你的地址。
CLASH_PROXY=http://127.0.0.1:10809
# 代理池控制口：/next 给每号分配独立 IP；单出口时留空
PROXY_CTRL=http://127.0.0.1:10810
# 内置 relay 监听端口（改这里后同步改上面两个地址；无需改时保持默认）
RELAY_PORT=10809
RELAY_CTRL_PORT=10810

# ---- SUB2API（可选，注册后导入 Grok 分组）----
SUB2API_URL=
SUB2API_EMAIL=
SUB2API_PASSWORD=
SUB2API_ADMIN_KEY=
SUB2API_GROK_GROUP=grok
SUB2API_GROK_PROXY_ID=0

# ---- 高级调优（可选）----
# 打码 ProxyLess 快速重试次数(间隔 5s)，CapSolver 节点被标记时可调大 5-8
GROK_CAP_RETRIES=3
